# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase (Project Settings → API) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── PayMongo (Phase 3) ─────────────────────────────────────────────────
PAYMONGO_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=pk_test_xxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxx
# Local demos only: simulate GCash/Maya/card when no PayMongo key is set. Never set in production.
PAYMENTS_MOCK=

# ─── Accounts (Phase 4) ─────────────────────────────────────────────────
# Accounts use Supabase Auth (email + Google). For local demos WITHOUT Supabase
# only, ACCOUNTS_DEMO=1 enables in-memory demo accounts. Never set in production.
ACCOUNTS_DEMO=
# Optional: keeps demo sessions valid across restarts.
DEMO_AUTH_SECRET=
# Demo mode only: comma-separated emails that get the admin dashboard.
DEMO_ADMIN_EMAILS=admin@highluxmnl.com

# ─── Cron (Phase 3 — sweeps lapsed item holds; Vercel sends it as a Bearer token) ──
CRON_SECRET=generate-a-long-random-string

# ─── Email (Phase 3 — order confirmations via Resend) ───────────────────
RESEND_API_KEY=re_xxx
EMAIL_FROM="HIGHLUX MNL <orders@highluxmnl.com>"

# ─── Meta / Facebook (Phase 6) ──────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
# Events Manager → your Pixel → Settings → Conversions API → Generate access token
META_CAPI_ACCESS_TOKEN=
# Optional: Events Manager → Test events code, to watch server events arrive while testing
META_TEST_EVENT_CODE=
# Optional: Graph API version for the Conversions API (default v23.0)
META_GRAPH_API_VERSION=
NEXT_PUBLIC_FB_PAGE_ID=
# Messenger username, e.g. highluxmnl → m.me/highluxmnl
NEXT_PUBLIC_MESSENGER_USERNAME=highluxmnl

# ─── Contact channels ───────────────────────────────────────────────────
NEXT_PUBLIC_VIBER_NUMBER=639170000000
NEXT_PUBLIC_WHATSAPP_NUMBER=639170000000
NEXT_PUBLIC_CONTACT_EMAIL=hello@highluxmnl.com
NEXT_PUBLIC_INSTAGRAM_HANDLE=highluxmnl
