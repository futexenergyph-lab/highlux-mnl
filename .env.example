# ─── Site ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase (Project Settings → API) ──────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── PayMongo (Phase 3) ─────────────────────────────────────────────────
PAYMONGO_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=pk_test_xxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxx

# ─── Email (Phase 3 — order confirmations via Resend) ───────────────────
RESEND_API_KEY=re_xxx
EMAIL_FROM="HIGHLUX MNL <orders@highluxmnl.com>"

# ─── Meta / Facebook (Phase 6) ──────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
NEXT_PUBLIC_FB_PAGE_ID=
# Messenger username, e.g. highluxmnl → m.me/highluxmnl
NEXT_PUBLIC_MESSENGER_USERNAME=highluxmnl

# ─── Contact channels ───────────────────────────────────────────────────
